{
  "manifest_version": 3,
  "name": "Clipperzinho",
  "version": "0.1.0",
  "description": "A little assistant that reads pages aloud with a local voice model, highlights as it goes, and keeps your notes.",
  "minimum_chrome_version": "128",
  "permissions": ["offscreen", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Clipperzinho"
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" },
  "commands": {
    "open-command-center": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open the command center"
    },
    "toggle-reading": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Play or pause reading"
    }
  }
}
